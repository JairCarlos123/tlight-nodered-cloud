  {
    "id": "cloud-input",
    "type": "http in",
    "z": "f6f2187d.f17ca8",
    "name": "Recibir datos del PLC",
    "url": "/api/tlight",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 120,
    "wires": [
      [
        "cloud-validate"
      ]
    ]
  },
  {
    "id": "cloud-validate",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "Validar y distribuir",
    "outputs": 4,
    "x": 430,
    "y": 120,
    "wires": [
      [
        "72fff7ad685cf81a"
      ],
      [
        "489afe71152d2a15"
      ],
      [
        "f353f870466e627b"
      ],
      [
        "cloud-response"
      ]
    ],
    "func": "const p = msg.payload;\nconst valid = p && ['luces','contadores','controles'].includes(p.kind) && Array.isArray(p.values);\nconst expected = {luces:5, contadores:5, controles:3};\nif (!valid || p.values.length !== expected[p.kind] ||\n    (p.kind === 'contadores' ? !p.values.every(v => Number.isInteger(v) && v >= -32768 && v <= 32767) : !p.values.every(v => typeof v === 'boolean'))) {\n    msg.statusCode = 400; msg.payload = {error:'Datos invalidos'};\n    return [null,null,null,msg];\n}\nconst values = p.values;\nconst update = {payload: p.kind === 'luces' ? {\n    p_red:values[0], p_green:values[1], v_red:values[2], v_yel:values[3], v_green:values[4]\n} : values};\nmsg.statusCode = 200;\nmsg.payload = {ok:true, receivedAt:new Date().toISOString()};\nreturn [p.kind === 'luces' ? update : null, p.kind === 'contadores' ? update : null, p.kind === 'controles' ? update : null, msg];"
  },
  {
    "id": "cloud-response",
    "type": "http response",
    "z": "f6f2187d.f17ca8",
    "name": "Confirmar recepcion",
    "statusCode": "",
    "headers": {
      "content-type": "application/json"
    },
    "x": 720,
    "y": 220,
    "wires": []
  }
