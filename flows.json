    "name": "Panel del semáforo",
    "order": 2,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"tlight-panel\">\n    <h2>Semáforo · OpenPLC</h2>\n    <p>{{ msg.payload ? 'Datos del PLC' : 'Esperando datos…' }}</p>\n\n    <div class=\"tlight-columns\">\n      <div>\n        <h3>Vehicular</h3>\n        <div class=\"tlight-box\">\n          <div class=\"tlight-lamp\"\n            :class=\"{ 'tlight-red': msg.payload?.v_red }\">\n            ROJO\n          </div>\n          <div class=\"tlight-lamp\"\n            :class=\"{ 'tlight-yellow': msg.payload?.v_yel }\">\n            AMARILLO\n          </div>\n          <div class=\"tlight-lamp\"\n            :class=\"{ 'tlight-green': msg.payload?.v_green }\">\n            VERDE\n          </div>\n        </div>\n      </div>\n\n      <div>\n        <h3>Peatonal</h3>\n        <div class=\"tlight-box\">\n          <div class=\"tlight-lamp\"\n            :class=\"{ 'tlight-red': msg.payload?.p_red }\">\n            ROJO\n          </div>\n          <div class=\"tlight-lamp\"\n            :class=\"{ 'tlight-green': msg.payload?.p_green }\">\n            VERDE\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n.tlight-panel {\n  padding: 16px;\n  text-align: center;\n}\n.tlight-columns {\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  gap: 28px;\n}\n.tlight-columns h3 {\n  margin: 12px 0;\n}\n.tlight-box {\n  background: #1f2937;\n  padding: 14px;\n  border-radius: 22px;\n}\n.tlight-lamp {\n  width: 82px;\n  height: 82px;\n  margin: 10px 0;\n  border-radius: 50%;\n  background: #374151;\n  color: white;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 11px;\n  font-weight: bold;\n}\n.tlight-red {\n  background: #ef4444;\n  box-shadow: 0 0 20px #ef444480;\n}\n.tlight-yellow {\n  background: #facc15;\n  color: #1f2937;\n  box-shadow: 0 0 20px #facc1580;\n}\n.tlight-green {\n  background: #22c55e;\n  box-shadow: 0 0 20px #22c55e80;\n}\n</style>|",
    "noerr": 0,
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
