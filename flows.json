    ]
  },
  {
    "id": "f353f870466e627b",
    "type": "ui-template",
    "z": "f6f2187d.f17ca8",
    "group": "86f0e36d893bd84d",
    "page": "",
    "ui": "",
    "name": "start",
    "order": 0,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div style=\"text-align:center; padding:16px\">\n    <template v-if=\"msg.payload?.length >= 3\">\n      <b>Start:</b> {{ Number(msg.payload[2]) }}\n      · <b>Izquierda:</b> {{ Number(msg.payload[1]) }}\n      · <b>Derecha:</b> {{ Number(msg.payload[0]) }}\n    </template>\n    <span v-else>Esperando controles…</span>\n  </div>\n</template>",
    "noerr": 0,
    "storeOutMessages": true,
