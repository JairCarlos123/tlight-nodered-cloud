  {
    "id": "cloud-input",
    "type": "http in",
    "z": "f6f2187d.f17ca8",
    "name": "Recibir datos del PLC",
    "url": "/api/tlight",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 120,
    "wires": [
      [
        "cloud-validate"
      ]
    ]
  },
  {
    "id": "cloud-validate",
    "type": "function",
    "z": "f6f2187d.f17ca8",
    "name": "Validar y distribuir",
    "outputs": 5,
    "x": 430,
    "y": 120,
    "wires": [
      [
        "72fff7ad685cf81a"
      ],
      [
        "489afe71152d2a15"
      ],
      [
        "f353f870466e627b"
      ],
      [
        "cloud-response"
      ],
      [
        "auto-ml-template"
      ]
    ],
    "func": "const incoming = msg.payload;\nif (incoming && incoming.kind === 'ml') {\n    const s = incoming.summary;\n    const base = s && ['ok','error'].includes(s.status) && typeof s.report === 'string' && s.report.length <= 255 && typeof s.processedAt === 'string' && Number.isFinite(Date.parse(s.processedAt)) && s.retrained === false && typeof s.message === 'string' && s.message.length <= 1200;\n    const valid = base && (s.status === 'error' || (\n        Number.isInteger(s.samples) && s.samples > 0 && Number.isInteger(s.normal) && s.normal >= 0 && Number.isInteger(s.alerts) && s.alerts >= 0 &&\n        s.normal+s.alerts === s.samples && Number.isFinite(s.alert_fraction) && Math.abs(s.alert_fraction-s.alerts/s.samples) < 1e-9 && typeof s.period === 'string'));\n    if (!valid) {\n        msg.statusCode=400; msg.payload={error:'Resumen ML invalido'};\n        return [null,null,null,msg,null];\n    }\n    const clean = {status:s.status, report:s.report, processedAt:s.processedAt, message:s.message, retrained:false, mode:'Análisis automático de CSV; no detección continua'};\n    if(s.status === 'ok') Object.assign(clean,{samples:s.samples,normal:s.normal,alerts:s.alerts,alert_fraction:s.alert_fraction,period:s.period});\n    msg.statusCode=200;msg.payload={ok:true,kind:'ml',receivedAt:new Date().toISOString()};\n    return [null,null,null,msg,{payload:clean}];\n}\nconst p = msg.payload;\nconst valid = p && ['luces','contadores','controles'].includes(p.kind) && Array.isArray(p.values);\nconst expected = {luces:5, contadores:5, controles:3};\nif (!valid || p.values.length !== expected[p.kind] ||\n    (p.kind === 'contadores' ? !p.values.every(v => Number.isInteger(v) && v >= -32768 && v <= 32767) : !p.values.every(v => typeof v === 'boolean'))) {\n    msg.statusCode = 400; msg.payload = {error:'Datos invalidos'};\n    return [null,null,null,msg];\n}\nconst values = p.values;\nconst update = {payload: p.kind === 'luces' ? {\n    p_red:values[0], p_green:values[1], v_red:values[2], v_yel:values[3], v_green:values[4]\n} : values};\nmsg.statusCode = 200;\nmsg.payload = {ok:true, receivedAt:new Date().toISOString()};\nreturn [p.kind === 'luces' ? update : null, p.kind === 'contadores' ? update : null, p.kind === 'controles' ? update : null, msg];"
  },
  {
    "id": "cloud-response",
    "type": "http response",
