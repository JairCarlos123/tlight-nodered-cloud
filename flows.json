    "y": 220,
    "wires": []
  },
  {
    "id": "auto-ml-group",
    "type": "ui-group",
    "name": "Análisis automático de CSV",
    "page": "be15b828bc2ec6ba",
    "width": "6",
    "height": "1",
    "order": 3,
    "showTitle": true,
    "className": "",
    "visible": "true",
    "disabled": "false",
    "groupType": "default"
  },
  {
    "id": "auto-ml-template",
    "type": "ui-template",
    "z": "f6f2187d.f17ca8",
    "group": "auto-ml-group",
    "page": "",
    "ui": "",
    "name": "Último análisis automático",
    "order": 1,
    "width": 0,
    "height": 0,
    "format": "<template>\n<section style=\"padding:20px\">\n<h2>Análisis automático de CSV</h2>\n<p v-if=\"!msg.payload\">Esperando el primer CSV analizado en tu computadora.</p>\n<template v-else>\n<p><b>{{ msg.payload.report }}</b><br>{{ msg.payload.mode }}</p>\n<p>Analizado: {{ new Date(msg.payload.processedAt).toLocaleString() }}</p>\n<template v-if=\"msg.payload.status === 'ok'\">\n<p>Periodo: {{ msg.payload.period }}</p>\n<p>Muestras: <b>{{ msg.payload.samples }}</b> · Normales: <b>{{ msg.payload.normal }}</b></p>\n<p>Alertas por revisar: <b>{{ msg.payload.alerts }}</b> ({{ (msg.payload.alert_fraction*100).toFixed(2) }} %)</p>\n<p>Modelo guardado, sin reentrenamiento.</p>\n</template>\n<p v-else style=\"color:#b91c1c\"><b>No se pudo evaluar este CSV.</b></p>\n<p>{{ msg.payload.message }}</p>\n<small>Resultado del último archivo recibido; no indica que el PLC siga conectado. Las alertas no son ataques confirmados. El modelo tiene bajo recall en las pruebas publicadas.</small>\n</template>\n</section>\n</template>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1030,
    "y": 440,
    "wires": [
      []
    ]
  }
